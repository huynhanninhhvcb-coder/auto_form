# Sao chép tệp này thành ".env" rồi điền giá trị thật. KHÔNG commit ".env" lên git
# và không chia sẻ API key trong chat/issue/log — hãy thu hồi ngay trên
# https://platform.openai.com/api-keys nếu key từng bị dán ra ngoài.

# Để trống để tắt hẳn tính năng AI hỗ trợ trích xuất (ứng dụng vẫn chạy OCR/regex như cũ).
OPENAI_API_KEY=

# Model có hỗ trợ vision. gpt-4o-mini rẻ và đủ dùng cho hầu hết giấy tờ;
# đổi sang gpt-4o nếu cần độ chính xác cao hơn với ảnh mờ/nghiêng.
OPENAI_MODEL=gpt-4o-mini

# Ký session Flask (chatbot thủ tục hành chính dùng để nhớ ngữ cảnh hội thoại).
# Bắt buộc phải đặt một giá trị ngẫu nhiên khi triển khai thực tế. Tạo bằng:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTO_FORM_SECRET_KEY=

# Chatbot thủ tục hành chính: khoá Google Drive API (chỉ cần quyền đọc công
# khai) và ID thư mục Drive chứa mẫu đơn/tờ khai. Để trống nếu chưa dùng tính
# năng "Mẫu đơn, tờ khai".
GOOGLE_DRIVE_API_KEY=
MAU_DON_FOLDER_ID=

# Nút "Hỏi trợ lý AI" của chatbot (gửi câu hỏi chưa có dữ liệu cục bộ cho
# ChatGPT trả lời, chỉ khi người dùng bấm xác nhận). Mặc định tắt; đặt
# "true" để bật. Độc lập với OPENAI_API_KEY dùng cho AI hỗ trợ trích xuất OCR.
CHATBOT_AI_ENABLED=false
